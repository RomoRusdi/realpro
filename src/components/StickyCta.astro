---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-kolega-bisnis.png";

/**
 * Wadah tujuan tombol CTA hero saat halaman di-scroll (dipindah oleh src/scripts/sticky-cta.ts via GSAP Flip):
 * - ≥768px: bar di atas layar (logo kiri, CTA kanan).
 * - <768px: CTA lebar penuh di bawah layar.
 * Tersembunyi secara default; tanpa JS tombol tetap di hero.
 */
---

<div class="sticky-top" data-sticky-top>
  <div class="container-page">
    <div class="sticky-bar">
      <!-- latar & logo dipisah dari slot agar bisa di-fade tanpa ikut memudarkan tombol yang sedang berpindah -->
      <span class="sticky-bar-bg" data-sticky-fade aria-hidden="true"></span>
      <a href="#top" class="bar-logo" data-sticky-fade aria-label="Kolega Bisnis — kembali ke atas">
        <Image src={logo} alt="" width={36} height={45} densities={[1, 2]} />
      </a>
      <div class="sticky-slot" data-sticky-slot></div>
    </div>
  </div>
</div>

<div class="sticky-bottom" data-sticky-bottom>
  <div class="sticky-slot" data-sticky-slot></div>
</div>

<style>
  .sticky-top,
  .sticky-bottom {
    position: fixed;
    z-index: 50;
    left: 0;
    right: 0;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .sticky-top {
    top: var(--sticky-top-gap);
  }

  .sticky-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--sticky-bar-h);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
  }

  .sticky-bar-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.7);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.25);
  }

  .bar-logo,
  .sticky-slot {
    pointer-events: auto;
  }

  .bar-logo {
    display: block;
    flex: none;
    border-radius: 6px;
  }

  .bar-logo :global(img) {
    display: block;
    width: 36px;
    height: auto;
  }

  /* CTA versi ringkas di dalam bar */
  .sticky-top .sticky-slot :global(.cta) {
    min-width: 0;
    min-height: 3.25rem;
    padding-block: 0.375rem;
  }

  .sticky-top .sticky-slot :global(.cta-chip) {
    width: 3.75rem;
    height: 2.5rem;
  }

  .sticky-bottom {
    bottom: 0;
    padding: 0 16px max(16px, env(safe-area-inset-bottom));
  }

  /* Tinggi slot dikunci agar wadah tidak berubah ukuran selama animasi Flip */
  .sticky-top .sticky-slot {
    min-height: 3.25rem;
  }

  .sticky-bottom .sticky-slot {
    min-height: 3.75rem;
  }

  @media (min-width: 768px) {
    .sticky-bottom {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .sticky-top {
      display: none;
    }
  }
</style>
