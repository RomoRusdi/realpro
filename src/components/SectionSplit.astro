---
interface Props {
  id: string;
  headingSmall: string;
  heading: string;
  tone?: "surface" | "cream" | "none";
  class?: string;
}

const { id, headingSmall, heading, tone = "surface", class: className } = Astro.props;
const toneClass = { surface: "bg-surface", cream: "bg-cream", none: "" }[tone];
const fadeColor = tone === "cream" ? "var(--color-cream)" : "var(--color-surface)";
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["split relative", toneClass, className]}>
  <div class="container-page grid gap-y-10 pt-section-t pb-section-b lg:grid-cols-2">
    <div class="split-heading-cell lg:pr-24">
      <h2 id={`${id}-title`} class="split-heading lg:sticky">
        <span class="block text-h2-sm font-normal">{headingSmall}</span>
        <span class="block text-h2 font-bold">{heading}</span>
      </h2>
    </div>

    <div class="split-body relative">
      <span class="split-line" data-split-line aria-hidden="true"></span>
      <slot />
    </div>
  </div>

  <span class="split-fade" style={`--fade-color: ${fadeColor}`} aria-hidden="true"></span>
</section>

<script>
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const section = entry.target.closest<HTMLElement>(".split");
      section?.style.setProperty("--heading-h", `${entry.borderBoxSize[0]?.blockSize ?? entry.contentRect.height}px`);
    }
  });
  document.querySelectorAll(".split-heading").forEach((heading) => observer.observe(heading));
</script>

<style>
  .split-heading {
    max-width: 677px;
    top: max(6.5rem, calc(140 * var(--s)));
  }

  .split-body {
    padding-left: max(1.5rem, calc(94 * var(--s)));
  }

  @media (max-width: 767px) {
    .split-body {
      padding-left: 1rem;
    }
  }

  .split-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--color-ink);
    transform-origin: top center;
  }

  .split-fade {
    display: none;
  }

  @media (min-width: 1024px) {
    .split-line {
      left: -1px;
    }

    .split {
      overflow: clip;
    }

    .split-heading-cell {
      margin-bottom: calc(-1 * var(--spacing-section-b));
    }

    .split-fade {
      display: block;
      position: absolute;
      z-index: 1;
      left: calc(29 * var(--s) - 60px);
      bottom: calc(-80 * var(--s) - 40px);
      right: calc(50% + 40px);
      height: max(calc(299 * var(--s)), calc(var(--heading-h, 0px) + 80 * var(--s) + 130px));
      background: var(--fade-color);
      filter: blur(25.1px);
      pointer-events: none;
    }
  }
</style>
