---
/**
 * Pola berulang dari Figma: judul di kiri (sticky di desktop), garis vertikal di tengah (x=960),
 * konten/daftar di kanan. Di bawah 1024px jadi satu kolom, garis pindah ke kiri daftar.
 *
 * Di desktop, dasar setiap section ditimpa bentuk blur sewarna latar (Figma: "Rectangle 13/17/18/20/21/24",
 * 793×299 di x=29, blur 25.1). Judul sticky meluncur sampai dasar section lalu tertutup bentuk itu,
 * sehingga tulisannya tampak memudar dan menghilang.
 */
interface Props {
  id: string;
  headingSmall: string;
  heading: string;
  /** `none` = transparan (dipakai bila latar disediakan wrapper, mis. garis oranye) */
  tone?: "surface" | "cream" | "none";
  class?: string;
}

const { id, headingSmall, heading, tone = "surface", class: className } = Astro.props;
const toneClass = { surface: "bg-surface", cream: "bg-cream", none: "" }[tone];
const fadeColor = tone === "cream" ? "var(--color-cream)" : "var(--color-surface)";
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["split relative", toneClass, className]}>
  <div class="container-page grid gap-y-10 pt-section-t pb-section-b lg:grid-cols-2">
    <div class="split-heading-cell lg:pr-24">
      <h2 id={`${id}-title`} class="split-heading lg:sticky">
        <span class="block text-h2-sm font-normal">{headingSmall}</span>
        <span class="block text-h2 font-bold">{heading}</span>
      </h2>
    </div>

    <div class="split-body relative">
      <span class="split-line" data-split-line aria-hidden="true"></span>
      <slot />
    </div>
  </div>

  <span class="split-fade" style={`--fade-color: ${fadeColor}`} aria-hidden="true"></span>
</section>

<script>
  // Simpan tinggi judul di section agar bentuk pemudar selalu cukup tinggi untuk menutupinya
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const section = entry.target.closest<HTMLElement>(".split");
      section?.style.setProperty("--heading-h", `${entry.borderBoxSize[0]?.blockSize ?? entry.contentRect.height}px`);
    }
  });
  document.querySelectorAll(".split-heading").forEach((heading) => observer.observe(heading));
</script>

<style>
  .split-heading {
    max-width: 677px;
    top: max(6rem, calc(140 * var(--s)));
  }

  .split-body {
    /* jarak dari garis ke kolom angka */
    padding-left: max(1.5rem, calc(94 * var(--s)));
  }

  @media (max-width: 767px) {
    .split-body {
      padding-left: 1rem;
    }
  }

  .split-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--color-ink);
    transform-origin: top center;
  }

  .split-fade {
    display: none;
  }

  @media (min-width: 1024px) {
    .split-line {
      left: -1px; /* tepat di tengah halaman (x=960 di Figma) */
    }

    /* `clip` (bukan `hidden`) agar position: sticky di dalamnya tetap bekerja */
    .split {
      overflow: clip;
    }

    /* Area sticky judul diperpanjang sampai dasar section (melewati padding bawah container).
       Pakai margin negatif, bukan padding: sticky berhenti di tepi *konten* parent-nya. */
    .split-heading-cell {
      margin-bottom: calc(-1 * var(--spacing-section-b));
    }

    .split-fade {
      display: block;
      position: absolute;
      z-index: 1;
      left: calc(29 * var(--s) - 60px); /* tepi blur kiri (±75px) digeser keluar layar agar tidak mengenai judul */
      bottom: calc(-80 * var(--s) - 40px); /* tepi blur bawah jatuh di luar section (ter-clip) */
      /* Figma: lebar 793 (x=29→822). Dibuat menutup seluruh kolom judul, berhenti sebelum garis tengah. */
      right: calc(50% + 40px);
      /* Tinggi = tinggi judul + ruang untuk tepi blur, agar judul tertutup penuh di akhir section.
         --heading-h diisi skrip di bawah; tanpa JS memakai ukuran Figma (299px). */
      height: max(calc(299 * var(--s)), calc(var(--heading-h, 0px) + 80 * var(--s) + 130px));
      background: var(--fade-color);
      filter: blur(25.1px);
      pointer-events: none;
    }
  }
</style>
