---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import CtaButton from "./CtaButton.astro";
import { hero, nav } from "../data/site";
import skyline from "../assets/images/hero-skyline.png";
import logo from "../assets/images/logo-kolega-bisnis.png";
---

<header id="top" class="hero relative isolate overflow-hidden" data-hero>
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <Image
      src={skyline}
      alt=""
      widths={[768, 1280, 1600, 2000]}
      sizes="(min-width: 1024px) 110vw, 200vw"
      loading="eager"
      fetchpriority="high"
      class="hero-bg-img"
      data-hero-parallax
    />
    <div class="hero-scrim absolute inset-0 lg:hidden"></div>
  </div>

  <div class="container-page hero-inner">
    <div class="hero-topbar" data-hero-reveal>
      <a href={nav.homeUrl} class="logo-card" aria-label="Kolega Bisnis — Beranda">
        <Image src={logo} alt="" width={76} height={96} densities={[1, 2]} loading="eager" class="logo-img" />
      </a>
      <a href={nav.servicesUrl} class="back-link">
        <Icon name="arrow-right" class="back-link-arrow" width={32} height={14.7279} aria-hidden="true" />
        <span>{nav.servicesLabel}</span>
      </a>
    </div>

    <h1 class="hero-title" data-hero-title>
      <span class="block text-hero-kicker font-medium tracking-[-0.01em]" data-split>{hero.kicker}</span>
      <span class="hero-accent block text-hero font-bold tracking-[-0.01em] text-hero-gradient" data-split data-split-gradient>
        {hero.title}
      </span>
    </h1>

    <p class="hero-lead text-hero-lead font-light text-shadow-hero" data-hero-reveal>
      {hero.lead}
    </p>

    <div class="hero-cta" data-hero-reveal>
      <CtaButton data-flip-cta />
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: calc(909 * var(--s));
  }

  .hero-bg :global(.hero-bg-img) {
    position: absolute;
    top: -9.6vw;
    left: 0;
    width: 110%;
    max-width: none;
    height: calc(100% + 9.6vw);
    object-fit: cover;
    object-position: right top;
  }

  @media (max-width: 1023px) {
    .hero-bg :global(.hero-bg-img) {
      left: auto;
      right: 0;
      width: 100%;
      object-position: 72% 100%;
    }
  }

  .hero-scrim {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.35) 0%, rgb(255 255 255 / 0.55) 45%, rgb(255 255 255 / 0.2) 100%);
  }

  .hero-inner {
    padding-top: max(1.25rem, calc(51 * var(--s)));
    padding-bottom: max(7rem, calc(216 * var(--s)));
  }

  .hero-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo-card {
    display: grid;
    place-items: center;
    width: max(5rem, calc(124 * var(--s)));
    aspect-ratio: 1;
    margin-left: calc(-8 * var(--s));
    border: 1px solid #fff;
    border-radius: var(--radius-logo);
    background: rgb(255 255 255 / 0.34);
    box-shadow: var(--shadow-glass);
  }

  .logo-card :global(.logo-img) {
    width: 61.3%;
    height: auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem 0.5rem 0.875rem;
    border: 1px solid #fff;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.34);
    box-shadow: var(--shadow-cta);
    font-size: clamp(0.875rem, 0.94vw, 1.125rem);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 0.25s var(--ease-out-2);
  }

  .back-link:hover,
  .back-link:focus-visible {
    background: #fff;
  }

  .back-link :global(.back-link-arrow) {
    width: 1.25rem;
    height: auto;
    transform: rotate(180deg);
    transition: transform 0.25s var(--ease-out-2);
  }

  .back-link:hover :global(.back-link-arrow),
  .back-link:focus-visible :global(.back-link-arrow) {
    transform: rotate(180deg) translateX(4px);
  }

  .hero-title {
    margin-top: max(2.5rem, calc(64 * var(--s)));
    max-width: 1307px;
  }

  .hero-accent {
    margin-top: 0.02em;
  }

  .hero-lead {
    margin-top: max(1.25rem, calc(24 * var(--s)));
    max-width: 1260px;
  }

  .hero-cta {
    margin-top: max(1.75rem, calc(47 * var(--s)));
  }
</style>
