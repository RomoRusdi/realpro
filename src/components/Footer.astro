---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { contact, footer } from "../data/site";
import logo from "../assets/images/logo-kolega-bisnis.png";
---

<footer class="bg-cream" aria-labelledby="footer-title">
  <div class="container-page footer-inner">
    <Image src={logo} alt="Kolega Bisnis" width={127} height={160} densities={[1, 1.25]} class="footer-logo" />

    <div class="footer-contact font-poppins">
      <h2 id="footer-title" class="contact-title">{footer.heading}</h2>
      <ul class="contact-list">
        <li>
          <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-link">
            <Icon name="whatsapp" class="contact-icon" style="--w:42;--h:42" aria-hidden="true" />
            <span><span class="sr-only">WhatsApp: </span>{contact.whatsappDisplay}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} class="contact-link">
            <Icon name="gmail" class="contact-icon" style="--w:43;--h:43" aria-hidden="true" />
            <span><span class="sr-only">Email: </span>{contact.email}</span>
          </a>
        </li>
        <li>
          <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-link contact-link--address">
            <Icon name="location" class="contact-icon" style="--w:49;--h:49" aria-hidden="true" />
            <address class="not-italic">
              <span class="sr-only">Alamat: </span>
              {contact.addressLines.map((line) => <span class="block">{line}</span>)}
            </address>
          </a>
        </li>
      </ul>
    </div>

    <p class="tagline">
      {
        footer.tagline.map(({ lead, accent }) => (
          <span class="block">
            <span class="font-garamond font-medium">{lead}</span>{" "}
            <span class="font-poppins font-bold text-tagline-gradient">{accent}</span>
          </span>
        ))
      }
    </p>
  </div>
</footer>

<style>
  /* Figma: logo 127×160 di x=122, "Get in Touch" x=300, teks kontak x=364, tagline rata kanan (right 133) */
  .footer-inner {
    display: grid;
    gap: 2.5rem;
    padding-top: max(3.5rem, calc(104 * var(--s)));
    padding-bottom: max(5.5rem, calc(110 * var(--s)));
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: max(2rem, calc(51 * var(--s)));
    }
    .tagline {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1280px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .tagline {
      grid-column: auto;
      padding-top: calc(52 * var(--s));
      text-align: right;
      margin-right: calc(6 * var(--s));
    }
  }

  .footer-inner :global(.footer-logo) {
    width: max(5.5rem, calc(127 * var(--s)));
    height: auto;
    margin-left: calc(-5 * var(--s));
  }

  .contact-title {
    font-size: var(--text-lead);
    line-height: 1.28; /* 41px @ 32px */
    font-weight: 700;
  }

  .contact-list {
    margin-top: max(0.75rem, calc(14 * var(--s)));
    display: grid;
    gap: max(0.75rem, calc(28 * var(--s)));
    list-style: none;
    padding: 0;
  }

  .contact-link {
    display: grid;
    grid-template-columns: max(2rem, calc(49 * var(--s))) minmax(0, 1fr);
    column-gap: max(0.75rem, calc(15 * var(--s)));
    align-items: center;
    font-size: var(--text-lead);
    line-height: 1.16; /* 37px @ 32px */
    font-weight: 300;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-link--address {
    align-items: start;
  }

  .contact-link--address address {
    max-width: max(16rem, calc(565 * var(--s))); /* Figma: alamat dibungkus di lebar 565 */
  }

  .contact-link:hover span,
  .contact-link:hover address {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-link :global(.contact-icon) {
    justify-self: center;
    width: max(calc(var(--w) * 0.65px), calc(var(--w) * var(--s)));
    height: max(calc(var(--h) * 0.65px), calc(var(--h) * var(--s)));
  }

  .tagline {
    font-size: var(--text-tagline);
    line-height: var(--text-tagline--line-height);
  }
</style>
