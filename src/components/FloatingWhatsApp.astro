---
import { Icon } from "astro-icon/components";
import { contact } from "../data/site";
---

<a
  href={contact.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Chat WhatsApp Kolega Bisnis (membuka tab baru)"
>
  <Icon name="logos:whatsapp-icon" class="wa-float-icon" aria-hidden="true" />
</a>

<style>
  .wa-float {
    position: fixed;
    z-index: 50;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 6px 20px -4px rgb(0 0 0 / 0.35);
    transition: transform 0.2s var(--ease-out-2);
  }

  @media (min-width: 1024px) {
    .wa-float {
      right: 2rem;
      bottom: 2rem;
      width: 4.25rem;
      height: 4.25rem;
    }
  }

  .wa-float:hover {
    transform: translateY(-3px);
  }

  .wa-float:active {
    transform: scale(0.95);
  }

  .wa-float :global(.wa-float-icon) {
    width: 62%;
    height: 62%;
  }
</style>
