---
import { Icon } from "astro-icon/components";
import { contact, ctaLabel } from "../data/site";

interface Props {
  label?: string;
  href?: string;
  class?: string;
  [key: `data-${string}`]: unknown;
}

const { label = ctaLabel, href = contact.whatsappUrl, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["cta group", className]}
  {...rest}
>
  <span class="cta-label">{label}</span>
  <span class="cta-chip" aria-hidden="true">
    <Icon name="arrow-right" class="cta-arrow" width={32} height={14.7279} />
  </span>
  <span class="sr-only"> (membuka WhatsApp di tab baru)</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: max(3.75rem, calc(77 * var(--s)));
    padding: max(0.5rem, calc(13 * var(--s))) max(0.5rem, calc(20 * var(--s))) max(0.5rem, calc(13 * var(--s)))
      max(1.25rem, calc(20 * var(--s)));
    border-radius: var(--radius-cta);
    background-image: linear-gradient(90deg, var(--color-cta-from), var(--color-cta-to));
    box-shadow: var(--shadow-cta);
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s var(--ease-out-2), box-shadow 0.2s var(--ease-out-2);
  }

  @media (min-width: 768px) {
    .cta {
      width: auto;
      min-width: max(22rem, calc(537 * var(--s)));
    }
    .cta-label {
      white-space: nowrap;
    }
  }

  .cta:active {
    transform: scale(0.97);
  }

  .cta-label {
    font-size: var(--text-cta);
    line-height: var(--text-cta--line-height);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cta-chip {
    flex: none;
    display: grid;
    place-items: center;
    width: max(4rem, calc(97 * var(--s)));
    height: max(2.75rem, calc(51 * var(--s)));
    border-radius: var(--radius-chip);
    background: rgb(255 255 255 / 0.1);
    box-shadow: var(--shadow-cta);
    color: #000;
    transition: background-color 0.25s var(--ease-out-2);
  }

  .cta:hover .cta-chip,
  .cta:focus-visible .cta-chip {
    background: #fff;
  }

  .cta-chip :global(.cta-arrow) {
    width: max(1.5rem, calc(31 * var(--s)));
    height: auto;
    transition: transform 0.25s var(--ease-out-2);
  }

  .cta:hover :global(.cta-arrow),
  .cta:focus-visible :global(.cta-arrow) {
    transform: translateX(6px);
  }
</style>
